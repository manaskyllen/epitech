# -------------------------
# iOS - Fichiers à ignorer
# -------------------------
# Pods (dépendances)
**/ios/Pods/
**/ios/.symlinks/
**/ios/Podfile.lock

# Flutter générés (mais pas le dossier entier !)
**/ios/Flutter/.last_build_id
**/ios/Flutter/App.framework
**/ios/Flutter/Flutter.framework
**/ios/Flutter/Flutter.podspec
**/ios/Flutter/Generated.xcconfig
**/ios/Flutter/ephemeral/
**/ios/Flutter/app.flx
**/ios/Flutter/app.zip
**/ios/Flutter/flutter_assets/
**/ios/Flutter/flutter_export_environment.sh

# Xcode user data (préférences perso)
**/ios/**/xcuserdata/
**/ios/**/*.xcuserdatad
**/ios/**/*.mode1v3
**/ios/**/*.mode2v3
**/ios/**/*.moved-aside
**/ios/**/*.pbxuser
**/ios/**/*.perspectivev3

# Build artifacts
**/ios/**/DerivedData/
**/ios/**/build/
**/ios/**/.generated/
**/ios/**/profile

# Autres fichiers générés
**/ios/ServiceDefinitions.json
**/ios/Runner/GeneratedPluginRegistrant.*

