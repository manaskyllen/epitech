# syntax=docker/dockerfile:1.7
FROM php:8.4-fpm-alpine AS php-base

# Runtime libs + build deps for PHP extensions.
RUN apk add --no-cache --virtual .build-deps \
    $PHPIZE_DEPS \
    icu-dev \
    libpng-dev \
    libjpeg-turbo-dev \
    freetype-dev \
    libzip-dev \
    libxml2-dev \
    oniguruma-dev \
    postgresql-dev \
    && docker-php-ext-configure gd \
    --with-freetype \
    --with-jpeg \
    && docker-php-ext-install -j"$(nproc)" \
    intl \
    pdo_pgsql \
    mbstring \
    zip \
    exif \
    pcntl \
    bcmath \
    gd \
    opcache \
    && apk del .build-deps \
    && apk add --no-cache \
    bash \
    curl \
    git \
    unzip \
    icu-libs \
    libpng \
    libjpeg-turbo \
    freetype \
    libzip \
    libxml2 \
    oniguruma \
    postgresql-libs

WORKDIR /var/www/html

FROM php-base AS composer-deps

COPY --from=composer:2 /usr/bin/composer /usr/bin/composer

COPY composer.json composer.lock ./

RUN --mount=type=cache,target=/tmp/composer-cache \
    COMPOSER_CACHE_DIR=/tmp/composer-cache \
    composer install \
    --no-dev \
    --optimize-autoloader \
    --no-interaction \
    --prefer-dist \
    --no-scripts

FROM node:22-alpine AS frontend-build

WORKDIR /app

COPY package.json package-lock.json ./

RUN --mount=type=cache,target=/root/.npm \
    npm ci --workspaces=false --include-workspace-root --install-links=false

COPY resources ./resources
COPY public ./public
COPY vite.config.js ./vite.config.js

RUN npm run build \
    && test -f public/build/manifest.json

FROM php-base AS final

WORKDIR /var/www/html

# Copy application sources after dependency layers so code changes keep cache hits.
COPY . .

# Provide a production env file during image build/runtime bootstrap.
COPY .env.prod .env

COPY --from=composer-deps /var/www/html/vendor /var/www/html/vendor
COPY --from=frontend-build /app/public/build /var/www/html/public/build

# Add preload script.
COPY preload.php /var/www/html/preload.php

# Composer scripts are skipped in the dependency stage, so publish package assets explicitly.
RUN php artisan package:discover --ansi \
    && php artisan filament:assets --ansi

# Keep a copy of the built public tree outside /var/www/html so runtime
# volume mounts can be refreshed with the assets from the current image.
RUN mkdir -p /opt/inspiria-public \
    && cp -a /var/www/html/public/. /opt/inspiria-public/

RUN { \
    echo "memory_limit=512M"; \
    } > /usr/local/etc/php/conf.d/memory-limit.ini

RUN { \
    echo "opcache.memory_consumption=256"; \
    echo "opcache.interned_strings_buffer=16"; \
    echo "opcache.max_accelerated_files=10000"; \
    echo "opcache.validate_timestamps=0"; \
    echo "opcache.preload_user=www-data"; \
    echo "opcache.fast_shutdown=1"; \
    } > /usr/local/etc/php/conf.d/opcache-custom.ini

RUN chown -R www-data:www-data /var/www/html \
    && chmod -R 777 /var/www/html/storage /var/www/html/bootstrap/cache

HEALTHCHECK CMD php artisan route:list > /dev/null 2>&1 || exit 1

COPY entrypoint.sh /usr/local/bin/entrypoint.sh
RUN chmod +x /usr/local/bin/entrypoint.sh
ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]

EXPOSE 9000
CMD ["php-fpm"]
